# Predložak lokalnih postavki: kopirajte u .env (NE commitajte .env – u .gitignore je).
#   cp .env.primjer .env        (Windows: copy .env.primjer .env)
# Varijable okruženja istog imena imaju prednost pred .env datotekom.

# TAJNA: ključ vanjskog servisa za obavijesti (najmanje 16 znakova). Bez nje se aplikacija ne pokreće.
OKVIRI_OBAVIJESTI_API_KLJUC=

# Lokalni Keycloak (../keycloak) radi na http://localhost:8180 bez TLS-a – SAMO u razvoju.
OKVIRI_ZAHTIJEVAJ_HTTPS=false
# OKVIRI_KEYCLOAK_ISSUER=http://localhost:8180/realms/akademija
# OKVIRI_KEYCLOAK_AUDIENCE=medtermin-api

# Više origina odvojite zarezom.
# OKVIRI_CORS_DOPUSTENI_ORIGINI=http://localhost:5173
# OKVIRI_PRIJAVA_POKUSAJA_U_MINUTI=5

# Swagger UI na /docs (samo lokalno).
OKVIRI_API_DOKUMENTACIJA=true
