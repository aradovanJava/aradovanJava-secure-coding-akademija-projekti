# Kopirajte ovu datoteku u .env i prilagodite vrijednosti.
#   Windows (PowerShell): Copy-Item .env.primjer .env
#   macOS / Linux:        cp .env.primjer .env

# Domena vašeg projekta iz 2. tjedna: medtermin | ulaznica | kadrovska
DOMENA=medtermin

# Lozinka za sa: najmanje 8 znakova, velika i mala slova, znamenke i simboli.
# Ne koristite znakove $ ' " ni razmake. OBAVEZNO je promijenite!
MSSQL_SA_PASSWORD=Promijeni-Me_2026

# Kad u zadatku Z2.4 napravite vlastitu administratorsku prijavu i onemogućite sa,
# upišite je ovdje i ponovno pokrenite: docker compose up -d
# (koriste je healthcheck, init i provjera). Prazno = sa / MSSQL_SA_PASSWORD.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Lokalni port (promijenite ako je 1433 zauzet, npr. 14333).
SQL_PORT=1433
