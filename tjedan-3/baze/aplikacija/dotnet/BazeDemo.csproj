<Project Sdk="Microsoft.NET.Sdk">
  <!-- Demo „Aplikacija i baza” (C#, ADO.NET): što aplikacijski račun smije u bazi.
       Pokretanje: dotnet run   (postavke iz varijabli okruženja – vidi README.md laboratorija) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BazeDemo</RootNamespace>
    <!-- NuGetAudit: poznate ranjivosti u ovisnostima javljaju se pri restoreu. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Sigurnosni demo ne smije imati ovisnost s poznatom ranjivošću: NU1901–NU1904 su greške, ne upozorenja. -->
    <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoftov upravljački program za SQL Server; verzija je zaključana (prate je Dependabot / NuGetAudit). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <!-- Tranzitivna ovisnost SqlClienta (9.0.x) ima poznate ranjivosti (NuGetAudit NU1902/NU1903):
         izravna referenca podiže je na zakrpanu verziju – isti postupak kao S06 u T2. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
