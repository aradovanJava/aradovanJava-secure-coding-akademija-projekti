---
 medtermin/platforma/postavke_api.py | 2 +-
 requirements.txt                    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/medtermin/platforma/postavke_api.py b/medtermin/platforma/postavke_api.py
index 7fff3fa..44a0310 100644
--- a/medtermin/platforma/postavke_api.py
+++ b/medtermin/platforma/postavke_api.py
@@ -34,7 +34,7 @@ def dohvati(korisnik: Prijavljeni, ctx: Ctx) -> dict[str, Any]:
 @router.post("")
 def spremi(tijelo: SirovoTijelo, korisnik: Prijavljeni, ctx: Ctx) -> dict[str, Any]:
     try:
-        dokument = yaml.safe_load(tijelo)
+        dokument = yaml.load(tijelo, Loader=yaml.FullLoader)
     except yaml.YAMLError as e:
         raise ApiGreska.neispravno("Neispravan YAML.") from e
     if not isinstance(dokument, dict):
diff --git a/requirements.txt b/requirements.txt
index afc4ae2..6bcb5e2 100644
--- a/requirements.txt
+++ b/requirements.txt
@@ -5,4 +5,4 @@ uvicorn==0.54.0
 python-multipart==0.0.33
 lxml==6.1.3
 argon2-cffi==25.1.0
-PyYAML==6.0.3
