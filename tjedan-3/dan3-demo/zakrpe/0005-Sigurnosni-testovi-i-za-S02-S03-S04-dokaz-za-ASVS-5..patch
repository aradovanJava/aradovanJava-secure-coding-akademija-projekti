+package hr.span.akademija.medtermin.sigurnost;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+/**
+ * S02 – path traversal kod preuzimanja datoteke (CWE-22). Kanarinac izvan mape s dokumentima ne smije se moći
+ * pročitati, ni kad mu ime sadrži korisničko ime.
+ * WSTG-ATHZ-01 · ASVS v5.0.0-5.3.2 (L1).
+ */
+@Tag("sigurnost")
+@DisplayName("S02 · Preuzimanje datoteke izvan mape s dokumentima")
+class S02PathTraversalTest extends SigurnosniTestBaza {
+
+    @Test
+    @DisplayName("../tajna-ana-… ne vraća sadržaj kanarinca")
+    void kanarinacIzvanMapeNijeDostupan() throws IOException {
+        String sadrzaj = "KANARINAC-" + UUID.randomUUID();
+        String ime = "tajna-ana-" + UUID.randomUUID() + ".txt";
+        Path kanarinac = mapaDokumenata().toAbsolutePath().getParent().resolve(ime);
+        Files.writeString(kanarinac, sadrzaj, StandardCharsets.UTF_8);
+        String ana = prijava("ana", "Ana12345!");
+
+        Odgovor odgovor = get("/api/nalazi/preuzmi?datoteka=" + enc("../" + ime), ana);
+
+        assertThat(odgovor.status()).isNotEqualTo(200);
+        assertThat(odgovor.tijelo()).doesNotContain(sadrzaj);
+    }
+}
diff --git a/src/test/java/hr/span/akademija/medtermin/sigurnost/S03OpenRedirectTest.java b/src/test/java/hr/span/akademija/medtermin/sigurnost/S03OpenRedirectTest.java
new file mode 100644
index 0000000..a5a0e88
--- /dev/null
+++ b/src/test/java/hr/span/akademija/medtermin/sigurnost/S03OpenRedirectTest.java
@@ -0,0 +1,29 @@
+package hr.span.akademija.medtermin.sigurnost;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Map;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+/**
+ * S03 – open redirect nakon prijave (CWE-601). Dopušten je samo lokalni put.
+ * ASVS v5.0.0-1.2.2 (L1).
+ */
+@Tag("sigurnost")
+@DisplayName("S03 · Preusmjeravanje nakon prijave")
+class S03OpenRedirectTest extends SigurnosniTestBaza {
+
+    @ParameterizedTest(name = "returnUrl={0}")
+    @ValueSource(strings = {"https://zlo.example/x", "//zlo.example", "/\\zlo.example"})
+    @DisplayName("vanjska adresa u returnUrl ne preusmjerava izvan aplikacije")
+    void nemaPreusmjerenjaVan(String returnUrl) {
+        Odgovor odgovor = postForma("/prijava",
+                Map.of("username", "ana", "password", "Ana12345!", "returnUrl", returnUrl));
+
+        assertThat(odgovor.status()).isEqualTo(302);
+        assertThat(odgovor.zaglavlje("Location")).doesNotContain("zlo.example");
+    }
+}
diff --git a/src/test/java/hr/span/akademija/medtermin/sigurnost/S04CorsTest.java b/src/test/java/hr/span/akademija/medtermin/sigurnost/S04CorsTest.java
new file mode 100644
