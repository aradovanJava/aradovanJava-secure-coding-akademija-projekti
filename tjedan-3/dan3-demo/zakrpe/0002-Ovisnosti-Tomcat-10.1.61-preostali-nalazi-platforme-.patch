From fc80c4300f43c7a9d1b33bf93b576c56954a931a Mon Sep 17 00:00:00 2001
From: Aleksander Radovan <aleksander.radovan@gmail.com>
Date: Wed, 18 Nov 2026 19:51:43 +0000
Subject: [PATCH 2/9] Ovisnosti: Tomcat 10.1.61; preostali nalazi platforme kao
 privremene iznimke s rokom (R-02)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Za Spring Framework 6.2 i Jackson iz Boota 3.5 nema OSS zakrpe: svaka iznimka u osv-scanner.toml ima
obrazloženje (koristi li se ranjiva funkcija) i rok 31. 1. 2027. (migracija na Spring Boot 4.1).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XPnKLRqpxkJxTv6qnqZmM6
---
 osv-scanner.toml | 40 ++++++++++++++++++++++++++++++++++++++++
 pom.xml          |  3 +++
 2 files changed, 43 insertions(+)

diff --git a/osv-scanner.toml b/osv-scanner.toml
index c5314ef..24ca0cc 100644
--- a/osv-scanner.toml
+++ b/osv-scanner.toml
@@ -5,3 +5,43 @@
 # id = "GHSA-xxxx-xxxx-xxxx"
 # ignoreUntil = 2026-12-31
 # reason = "Ranjiva funkcija se ne koristi; nadogradnja čeka Spring Boot 3.5.x"
+
+# --- Spring Boot 3.5.16 (zadnje OSS izdanje 3.5, bez podrške od 30. 6. 2026.) ---
+# Tomcat je podignut na 10.1.61 (pom.xml, tomcat.version). Za Spring Framework 6.2 i Jackson iz Boota 3.5
+# nema OSS zakrpe unutar 3.5: rješenje je migracija na Spring Boot 4.1 (Dependabot PR #4) – registar rizika R-02.
+# Iznimke vrijede do roka migracije; nakon roka vrata ponovno padaju i odluku treba obnoviti ili provesti migraciju.
+
+[[IgnoredVulns]]
+id = "GHSA-j9f9-w8pj-32f8"
+ignoreUntil = 2027-01-31
+reason = "spring-webmvc 6.2.19: SSE i renderiranje fragmenata (FragmentsRendering) aplikacija ne koristi. R-02, migracija na Boot 4.1."
+
+[[IgnoredVulns]]
+id = "GHSA-pc63-qcmh-9cmg"
+ignoreUntil = 2027-01-31
+reason = "spring-webmvc 6.2.19: XsltView aplikacija ne koristi (nema XSLT prikaza). R-02, migracija na Boot 4.1."
+
+[[IgnoredVulns]]
+id = "GHSA-7hhh-6rmp-j9qf"
+ignoreUntil = 2027-01-31
+reason = "jackson-core 2.21.4: DoS pri neispravnom JSON-u; utjecaj samo na dostupnost (R-06). Ispravak s Boot 4.1 (R-02)."
+
+[[IgnoredVulns]]
+id = "GHSA-p6pp-m3f8-5c89"
+ignoreUntil = 2027-01-31
+reason = "jackson-core 2.21.4: ReDoS u provjeri broja; utjecaj samo na dostupnost (R-06). Ispravak s Boot 4.1 (R-02)."
+
+[[IgnoredVulns]]
+id = "GHSA-cxp5-3px4-pw24"
+ignoreUntil = 2027-01-31
+reason = "jackson-databind 2.21.4: DoS (forward reference); aplikacija ne koristi @JsonIdentityInfo. Ispravak s Boot 4.1 (R-02)."
+
+[[IgnoredVulns]]
+id = "GHSA-q4xh-88c3-wmh7"
+ignoreUntil = 2027-01-31
+reason = "jackson-databind 2.21.4: DoS pri parsiranju Duration/XMLGregorianCalendar; API ne prima ta polja. Ispravak s Boot 4.1 (R-02)."
+
+[[IgnoredVulns]]
+id = "GHSA-wv8q-qhhj-9h54"
+ignoreUntil = 2027-01-31
+reason = "jackson-databind 2.21.4: zadržavanje nepoznatih ID-jeva tipova; aplikacija ne koristi polimorfnu deserijalizaciju. Ispravak s Boot 4.1 (R-02)."
diff --git a/pom.xml b/pom.xml
index 4082aaf..e2ded23 100644
--- a/pom.xml
+++ b/pom.xml
@@ -19,6 +19,9 @@
 
     <properties>
         <java.version>21</java.version>
+        <!-- Tomcat 10.1 je i dalje podržan: zakrpa iznad verzije iz Spring Boota 3.5.16 (zadnje OSS izdanje 3.5).
+             Ukloniti kad prijeđemo na Spring Boot 4.x (registar rizika R-02). -->
+        <tomcat.version>10.1.61</tomcat.version>
         <jacoco.version>0.8.13</jacoco.version>
     </properties>
 
-- 
2.43.0

