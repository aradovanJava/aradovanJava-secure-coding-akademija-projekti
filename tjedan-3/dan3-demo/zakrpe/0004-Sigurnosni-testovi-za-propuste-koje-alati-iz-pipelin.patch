+package hr.span.akademija.medtermin.sigurnost;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Tag;
+
+/**
+ * S13 – fail-open (CWE-636, CWE-209). Iznimka nastaje samo na rubnom ulazu koji skener ne šalje.
+ * WSTG-ERRH-01, WSTG-ATHZ-02 · ASVS v5.0.0-16.5.3 (L2).
+ */
+@Tag("sigurnost")
+@DisplayName("S13 · Nepoznat format na tuđem nalazu")
+class S13FailOpenTest extends SigurnosniTestBaza {
+
+    @ParameterizedTest(name = "format=\"{0}\"")
+    @ValueSource(strings = {"xml", ""})
+    @DisplayName("marko ne dobiva anin nalaz ni tekst iznimke")
+    void tudiNalazSNepoznatimFormatom(String format) {
+        String marko = prijava("marko", "Marko12345!");
+
+        Odgovor odgovor = get("/api/nalazi/1?format=" + format, marko);
+
+        assertThat(odgovor.status()).isIn(400, 403, 404);
+        assertThat(odgovor.tijelo())
+                .doesNotContain("Krvna slika")
+                .doesNotContain("Exception")
+                .doesNotContain("at hr.");
+    }
+}
